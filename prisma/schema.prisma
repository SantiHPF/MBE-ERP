// MBE ERP data model.
//
// Three ideas drive the shape of this schema:
//
//   1. Availability is computed, never stored. A person's capacity on a date
//      comes from WorkingPattern -> DayOverride -> Absence, resolved by
//      getAvailability(). Nothing caches the result.
//   2. Fairness is remembered. RotationLedger is what stops the same person
//      always getting the same recurring job.
//   3. Nothing disappears silently. Tasks orphaned by an absence keep their
//      history, and every triage decision is recorded.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- people

/// Interface language. Data -- task names, notes, meeting minutes -- is left
/// exactly as typed, whichever this is set to.
enum Locale {
  EN
  ES
}

enum Role {
  WORKER
  MANAGER
  /// People operations: creates accounts and decides absence requests, across
  /// every department. Sits alongside MANAGER rather than above it -- HR does
  /// not run anyone else's schedule.
  HR
  ADMIN
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users          User[]
  taskTemplates  TaskTemplate[]
  recurringRules RecurringRule[]
  tasks          Task[]
  meetings       Meeting[]
  sheetSources   SheetSource[]
  actionItems    ActionItem[]
  p1ns           P1n[]
  crmSources     CrmSource[]
  candidates     Candidate[]
  crmInteractions CrmInteraction[]
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(WORKER)
  locale       Locale   @default(ES)
  /// When they last opened the alerts popover. Everything newer is unread.
  /// One nullable column instead of a Notification table with per-row read
  /// state -- the rows are derived, so there is nothing to mark but the look.
  notificationsSeenAt DateTime?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  /// When they joined. Drives the onboarding interviews, and nothing is ever
  /// scheduled for them before it.
  startDate    DateTime? @db.Date
  /// When they leave. Null means indefinite -- most people. Nothing is
  /// scheduled past it, and the recurring review interviews stop there.
  endDate      DateTime? @db.Date

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  workingPatterns WorkingPattern[]
  dayOverrides    DayOverride[]
  absences        Absence[]        @relation("AbsenceSubject")
  absencesCreated Absence[]        @relation("AbsenceAuthor")
  absencesDecided Absence[]        @relation("AbsenceDecider")
  tasks           Task[]           @relation("TaskAssignee")
  timeEntries     TimeEntry[]
  rotation        RotationLedger[]
  sessions        Session[]
  attendance      AttendanceDay[]
  triageActions   TriageAction[]
  deferrals       TaskDeferral[]
  blocks          TaskBlock[]
  messagesSent     Message[] @relation("MessageSender")
  messagesReceived Message[] @relation("MessageRecipient")
  p1ns            P1n[]
  p1nsApplied     P1n[]            @relation("P1nApplier")
  meetingsCreated Meeting[]        @relation("MeetingAuthor")
  meetingsAttended Meeting[]       @relation("MeetingAttendees")
  pinnedItems     ActionItem[]     @relation("ActionItemPin")
  crmCalls        CrmInteraction[] @relation("CrmCaller")
  reports       Report[]
  closedReports Report[] @relation("ReportCloser")

  @@index([departmentId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ------------------------------------------------------------ attendance

/// Which signal produced a clock-in or clock-out.
///
/// Kept on the record rather than thrown away, because "they pressed the
/// button" and "we guessed from the last thing they did" are not the same
/// claim, and only one of them should be trusted without asking.
enum AttendanceSource {
  LOGIN
  TASK_START
  TASK_END
  LOGOUT
  /// They pressed "close the day".
  DAY_CLOSED
  /// Nobody closed it, so the sweep did -- see sweepOpenDays().
  AUTO_CLOSE
  /// Corrected by hand afterwards.
  MANUAL
}

enum AttendanceStatus {
  OPEN
  CLOSED
  /// Inferred rather than recorded. Shown to the person to confirm.
  NEEDS_REVIEW
}

/// When somebody was actually here.
///
/// Every signal is stored separately and the pair that counts is derived from
/// them, so "arrived at 08:00 but did not start work until 10:30" stays an
/// answerable question. Collapsing them into one in/out on the way in is
/// exactly what would lose it.
///
/// This is an operational record, not a legal registro de jornada -- it is
/// editable after the fact and has no retention guarantee. See the README.
model AttendanceDay {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calendar day in SCHEDULE_TIMEZONE, like every other date here.
  date   DateTime @db.Date

  /// The earliest signal of the day, and which one it was.
  startedAt   DateTime?
  startSource AttendanceSource?
  /// The latest. Null while the day is still open.
  endedAt   DateTime?
  endSource AttendanceSource?

  /// Lunch, clocked the same way the day is: an actual out and an actual in,
  /// against the rostered break on the WorkingPattern. Both null means nobody
  /// clocked it, which is read as "took it exactly as rostered" rather than
  /// as "took none" -- see breakDrift() in lib/attendance/attendance.ts.
  breakStartedAt DateTime?
  breakEndedAt   DateTime?

  firstLoginAt     DateTime?
  firstTaskStartAt DateTime?
  lastTaskEndAt    DateTime?
  logoutAt         DateTime?
  /// Last proof of life: any start, pause, resume or completion. What the
  /// fallback sweep closes an abandoned day at.
  lastActivityAt DateTime?

  status AttendanceStatus @default(OPEN)
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Makes every write an upsert, and a duplicate day impossible.
  @@unique([userId, date])
  @@index([status, date])
}

// ------------------------------------------------------------ time model

/// One row per weekday per person. Different hours on different days is just
/// different rows -- Monday 09:00-18:00 and Friday 09:00-14:00 coexist here.
/// Times are minutes from midnight in SCHEDULE_TIMEZONE, which keeps the
/// arithmetic free of DST edge cases.
model WorkingPattern {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1 = Monday ... 7 = Sunday (ISO weekday)
  weekday      Int
  startMinutes Int
  endMinutes   Int
  breakMinutes Int    @default(0)
  /// When the break sits at a known time, tasks are scheduled around it and
  /// the day splits in two. When null, the break still costs capacity but
  /// work can be placed anywhere.
  breakStartMinutes Int?

  @@unique([userId, weekday])
}

/// A specific date where this person's hours differ from their weekday
/// pattern. Beats the pattern entirely for that date.
model DayOverride {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  startMinutes Int
  endMinutes   Int
  breakMinutes Int      @default(0)
  breakStartMinutes Int?
  note         String?

  @@unique([userId, date])
}

enum AbsenceScope {
  FULL_DAY
  PARTIAL
}

/// Coarse category only. Deliberately not a free-text medical field --
/// see the GDPR note in the README.
enum AbsenceCategory {
  SICK
  HOLIDAY
  PERSONAL
  OTHER
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

model Absence {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation("AbsenceSubject", fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime        @db.Date
  endDate   DateTime        @db.Date
  scope     AbsenceScope    @default(FULL_DAY)
  /// Only meaningful when scope = PARTIAL. Minutes from midnight.
  startMinutes Int?
  endMinutes   Int?
  category  AbsenceCategory
  note      String?
  createdAt DateTime        @default(now())

  /// HR decides every absence, but sickness does not wait for the decision --
  /// see isEffective() in src/lib/absence/effective.ts. A pending sick day
  /// already affects the schedule; a pending holiday does not.
  status       AbsenceStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?         @relation("AbsenceDecider", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?

  createdById String
  createdBy   User   @relation("AbsenceAuthor", fields: [createdById], references: [id])

  @@index([userId, startDate, endDate])
  @@index([status])
}

// ------------------------------------------------------------------ work

/// The task catalogue. Durations already exist here, so instances inherit
/// rather than guess.
model TaskTemplate {
  id               String   @id @default(cuid())
  name             String
  category         String?
  estimatedMinutes Int
  /// Warnings and gotchas from the catalogue -- "max 1 integrante por dia",
  /// "apuntalo en el calendario para que no se solape". Shown on the task,
  /// because a rule nobody sees at the moment of doing the work is not a rule.
  notes            String?
  /// Where to look for how to do it: "Ver Calendar", "Ver ModeloPreguntas".
  instructions     String?
  /// True for tasks that are actually meetings -- starting one opens the
  /// notes pane instead of just running a timer.
  isMeeting        Boolean  @default(false)
  /// True when the estimate is for one go and people normally do several --
  /// a candidate call, an invoice, a check-in. Lets the day hold "10 calls"
  /// as one block instead of ten identical rows.
  repeatable       Boolean  @default(false)
  /// How long one sitting of this job should be, when the whole job is too
  /// long to do in one. Null means the default in lib/plan/sessions.ts.
  ///
  /// It lives on the catalogue rather than being worked out from whoever
  /// picks the job up: the engine's re-runs have to be a pure function of the
  /// rules and the calendar, and sizing a sitting from one person's longest
  /// free window would make the second run split differently from the first.
  sessionMinutes   Int?
  priority         Priority @default(NORMAL)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  /// "This one comes after that one." Set on the follower, so several entries
  /// may hang off the same leader -- reviewing the portals can produce both a
  /// report and a Gantt update. Null for work that stands on its own.
  /// Keep instances of this entry in one half of the day. Null means anywhere.
  shiftHalf ShiftHalf?

  followsId String?
  follows   TaskTemplate?  @relation("TemplateFollows", fields: [followsId], references: [id], onDelete: SetNull)
  followers TaskTemplate[] @relation("TemplateFollows")

  recurringRules RecurringRule[]
  tasks          Task[]
  rotation       RotationLedger[]

  @@unique([departmentId, name])
  @@index([followsId])
}

/// How hard a task pushes for capacity.
enum Priority {
  /// Has to happen. Takes first claim on the day and is assigned even when
  /// everybody is full, so the overload is visible rather than the task
  /// quietly vanishing.
  MUST
  /// Normal work: scheduled when there is room.
  NORMAL
  /// Backlog. Only appears once everything else has been placed and somebody
  /// still has hours free.
  SPARE_TIME
}

enum Frequency {
  WEEKLY
  MONTHLY
}

/// A point in somebody's working day, rather than a time on the clock.
///
/// "When I arrive" is 09:00 for one person and 08:00 for another, so a task
/// done at the start of every shift cannot be expressed as a fixed time. These
/// resolve per person against the windows computeAvailability() returns, which
/// already have the break carved out.
/// Which part of the working day a task belongs in, when it has no anchor and
/// no clock time but still should not drift. Split at one company-wide hour --
/// see src/lib/scheduling/half.ts.
enum ShiftHalf {
  MORNING
  AFTERNOON
}

enum DayAnchor {
  ARRIVAL
  BEFORE_BREAK
  AFTER_BREAK
  BEFORE_LEAVING
}

/// "This catalogue task happens every Monday and Thursday", or "the last
/// Monday of the month". Modelled on the subset of iCalendar recurrence the
/// company's calendar actually uses -- weekly by weekday, and monthly by
/// nth-weekday or day-of-month.
model RecurringRule {
  id                    String  @id @default(cuid())
  templateId            String
  template              TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  departmentId          String
  department            Department   @relation(fields: [departmentId], references: [id])

  frequency             Frequency @default(WEEKLY)
  /// ISO weekdays this fires on, e.g. [1, 4] for Monday and Thursday. For a
  /// MONTHLY rule this holds the single weekday that monthlyNth counts.
  weekdays              Int[]
  /// MONTHLY only: which occurrence of that weekday. 1 = first, -1 = last
  /// (RRULE BYDAY=-1MO). Null when the rule uses monthlyDay instead.
  monthlyNth            Int?
  /// MONTHLY only: a fixed day of the month (RRULE BYMONTHDAY=22).
  monthlyDay            Int?

  instancesPerOccurrence Int    @default(1)
  /// Points in the shift this fires at, in order. When set, its length replaces
  /// instancesPerOccurrence and every repetition of a day goes to one person --
  /// opening and closing checks are one person's routine, not a rota.
  /// Each anchor appears at most once: the task's external key is built from it.
  anchors               DayAnchor[]
  /// Optional fixed slot. When set, the task must land in this window and is
  /// placed before flexible work. Only genuine appointments get one -- most
  /// calendar times are reminders, and pinning them all makes the schedule
  /// unsolvable.
  fixedStartMinutes     Int?
  fixedEndMinutes       Int?
  active                Boolean @default(true)
  /// Where this came from, for tracing an odd schedule back to its source.
  sourceNote            String?

  @@index([departmentId])
}

enum TaskOrigin {
  RECURRING
  CATALOGUE
  SHEET
  MEETING
  MANUAL
  /// A batch of calls the CRM raised: one task holding a list of people, not
  /// one task per person.
  CRM
}

enum TaskStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  PAUSED
  ORPHANED
  /// Still yours and still today, but stepped over: somebody said they could
  /// not do it and chose to keep it. The day runs in order, so without this a
  /// single stuck task holds up everything below it.
  SET_ASIDE
  DONE
  CANCELLED
  /// Not work: a job too long for one sitting, holding the sittings that are.
  /// Never has a slot, never counts towards anybody's day. A status rather
  /// than a flag because nearly every filter here is an allow-list, so a new
  /// value is excluded from all of them by construction. See lib/plan/sessions.ts.
  SPLIT
}

model Task {
  id               String     @id @default(cuid())
  title            String
  description      String?
  /// Always the total: unitMinutes x quantity. Everything that reasons about
  /// capacity reads this and needs to know nothing about repeats.
  estimatedMinutes Int
  /// Minutes for one go, when this is a repeatable task.
  unitMinutes      Int?
  /// How many are planned.
  quantity         Int        @default(1)
  /// How many have actually been done, counted while working.
  doneCount        Int        @default(0)
  dueDate          DateTime   @db.Date
  origin           TaskOrigin
  status           TaskStatus @default(UNASSIGNED)
  /// Copied from the template when the task is created, so changing the
  /// catalogue later does not rewrite work already scheduled.
  priority         Priority   @default(NORMAL)
  createdAt        DateTime   @default(now())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  templateId String?
  template   TaskTemplate? @relation(fields: [templateId], references: [id])

  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  /// Stable identity for generated work, so re-running the materializer or
  /// re-polling the sheet updates instead of duplicating.
  externalKey String? @unique

  /// A parent (status SPLIT) never has any of these three. That one fact is
  /// what keeps it out of My Day, the now-bar, pace, /team and triage's
  /// totals -- every day-scoped query in the app filters on scheduledDate --
  /// without any of them having to learn what a parent is. Nothing may set a
  /// slot on a SPLIT row; verify:sessions asserts it.
  scheduledDate  DateTime? @db.Date
  scheduledStart Int?
  scheduledEnd   Int?

  /// Which point in the shift this instance belongs to, copied from the rule
  /// when it was generated. Stored on the task so re-placing it later --
  /// placeOnDay after a deferral, a manual reorder -- can still honour it.
  anchor DayAnchor?

  /// Copied from the template when the task is created, for the same reason
  /// `anchor` is: re-placing it later must still honour it.
  shiftHalf ShiftHalf?

  orphanedAt   DateTime?
  orphanReason String?

  /// Why the engine could not place it, from assignDay's Unassigned union.
  /// Worked out every run and previously thrown away, which is why triage
  /// could only ever show a count of work nobody had room for.
  unplacedReason String?

  timeEntries   TimeEntry[]
  crmInteractions CrmInteraction[]
  triageActions TriageAction[]
  deferrals     TaskDeferral[]
  blocks        TaskBlock[]
  messages      Message[]
  p1ns          P1n[]
  reports Report[]
  actionItem    ActionItem?
  /// Set when this task is itself a meeting being minuted.
  hostedMeeting Meeting?       @relation("MeetingSourceTask")

  /// The instance this one follows, for this day. Deleting the leader takes
  /// its followers with it: the second half of a pair means nothing alone.
  followsTaskId String?
  followsTask   Task?  @relation("TaskFollows", fields: [followsTaskId], references: [id], onDelete: Cascade)
  followers     Task[] @relation("TaskFollows")

  /// The long job this is one sitting of. Cascades like followsTaskId does:
  /// one slice of a job means nothing once the job is gone.
  ///
  /// Deliberately not the same link as followsTaskId -- the engine walks that
  /// one to a chain root and places the whole chain inside a single day, which
  /// is the exact thing sittings exist to avoid.
  parentTaskId String?
  parent       Task?  @relation("TaskSessions", fields: [parentTaskId], references: [id], onDelete: Cascade)
  sessions     Task[] @relation("TaskSessions")

  /// 1-based, in the order the sittings have to happen. Null on everything
  /// else. Unique per parent, enforced by a partial index in the migration.
  sessionIndex Int?

  @@index([departmentId, dueDate])
  @@index([assigneeId, scheduledDate])
  @@index([status])
  @@index([parentTaskId])
  @@index([followsTaskId])
  /// Also has a partial unique index that Prisma cannot express, added by hand
  /// in 20260728140000_concurrency_guards:
  ///   ("templateId", "dueDate") WHERE origin = 'CATALOGUE' AND status <> 'CANCELLED'
  /// It stops two people claiming the same plan-board cell at once. Scoped to
  /// CATALOGUE because a rule with instancesPerOccurrence > 1 legitimately
  /// creates several RECURRING tasks for one template on one day.
}

model TimeEntry {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  pauses PauseEvent[]

  @@index([taskId])
  @@index([userId, startedAt])
  /// Also has a partial unique index that Prisma cannot express, added by hand
  /// in 20260728140000_concurrency_guards:
  ///   ("userId") WHERE "endedAt" IS NULL
  /// One running clock per person, enforced by the database rather than only
  /// by startTask().
}

enum PauseReason {
  BREAK
  WAITING_CLIENT
  WAITING_INTERNAL
  MEETING
  INTERRUPTION
  OTHER
}

/// Every pause carries a written reason. That requirement is the whole point:
/// the system surfaces why work stalled instead of who was idle.
model PauseEvent {
  id          String      @id @default(cuid())
  timeEntryId String
  timeEntry   TimeEntry   @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  pausedAt    DateTime    @default(now())
  resumedAt   DateTime?
  reasonCode  PauseReason
  reasonText  String

  @@index([timeEntryId])
}

/// Fairness memory: how often this person has done this template, and when
/// they last got it. Drives rotation ranking.
model RotationLedger {
  id             String    @id @default(cuid())
  templateId     String
  template       TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Times this person has been *given* the job. This is what rotation ranks
  /// on -- fairness is about who gets handed the work, and a task assigned
  /// but not yet finished still counts as their turn.
  assignedCount  Int       @default(0)
  /// Times they actually finished it. Kept for reporting (and for spotting a
  /// job that keeps getting handed over half-done), not for ranking.
  completedCount Int       @default(0)
  lastAssignedAt DateTime?

  @@unique([templateId, userId])
}

enum TriageResolution {
  REASSIGNED
  PUSHED
  CANCELLED
}

/// Why somebody could not do a task when they were meant to, and when they
/// said they would instead. Written when the day's order is overridden.
model TaskDeferral {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  reason    String
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId, createdAt])
}

/// One thing said to one person.
///
/// No thread table: a conversation is every message between two people in
/// either direction, ordered by time, which is all this needs and keeps the
/// unread count a single indexed count rather than an aggregate.
model Message {
  id String @id @default(cuid())

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id])

  recipientId String
  recipient   User   @relation("MessageRecipient", fields: [recipientId], references: [id])

  body String

  /// Set when it was sent alongside a task -- handing work over with a word
  /// about why, or a block report. Nullable and SET NULL on delete: a message
  /// about a task that has since been cancelled is still a message.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  /// The unread badge, which runs on every page load.
  @@index([recipientId, readAt])
  /// The inbox, newest first.
  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

/// What the person chose to happen to work they could not do.
enum BlockOutcome {
  /// Moved to another day. Also writes a TaskDeferral, as deferring always has.
  MOVED
  /// Given back to the manager: orphaned, and in the triage queue.
  HANDED_BACK
  /// Kept for today, but stepped over so it stops holding up the rest.
  SET_ASIDE
  /// "This does not need doing" -- a request, not a decision. Only a manager
  /// cancels work.
  CANCEL_REQUESTED
}

/// Somebody could not do a task, and said why.
///
/// Distinct from PauseEvent, which is a stoppage inside work already started,
/// and from TaskDeferral, which records only that a date moved. This is the
/// person's account of why the plan did not survive contact with the day, and
/// it is what the manager reads in triage.
model TaskBlock {
  id      String @id @default(cuid())
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  reason  String
  outcome BlockOutcome
  /// Where it went, for MOVED.
  movedTo DateTime? @db.Date
  /// Set once a manager has dealt with it. Null means it is still in the queue.
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([taskId])
  @@index([resolvedAt, createdAt])
}

/// Why a task moved. Written whenever an orphan is resolved -- by a manager in
/// triage, or by whoever picked it up out of their own free time, which is the
/// only way one leaves the queue without a manager seeing it first.
model TriageAction {
  id         String           @id @default(cuid())
  taskId     String
  task       Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  resolvedById String
  resolvedBy   User           @relation(fields: [resolvedById], references: [id])
  resolution TriageResolution
  detail     String?
  createdAt  DateTime         @default(now())

  @@index([taskId])
}

// ------------------------------------------------------------------ P1N

/// Why the mistake happened. In practice it is nearly always one of the first
/// two, and telling them apart is the whole point: one is fixed by paying
/// attention, the other by fixing the process.
enum P1nCause {
  /// Dejadez -- not attentive enough.
  ATTENTION
  /// It was not written down or explained properly.
  PROCESS
  OTHER
}

/// "Pasa 1 vez, no vuelve a pasar."
///
/// Somebody reports their own mistake, says why it happened and proposes what
/// would stop it happening again -- to them or to whoever comes after. The
/// department can read them, because a fix nobody sees teaches nobody.
model P1n {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  mistake   String
  cause     P1nCause
  solution  String

  /// The task it happened on, when there was one.
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// Set when the proposed fix has actually been made, which is the only
  /// thing that turns a report into a change.
  appliedAt   DateTime?
  appliedById String?
  appliedBy   User?     @relation("P1nApplier", fields: [appliedById], references: [id])
  appliedNote String?

  @@index([departmentId, createdAt])
  @@index([userId])
}

// --------------------------------------------------------------- reports

/// What somebody is telling us. A defect and an idea want the same box and
/// the same list; only the reader's expectation differs.
enum ReportKind {
  BUG
  IDEA
}

enum ReportStatus {
  OPEN
  CLOSED
}

/// Something noticed while using the ERP, filed from wherever it was noticed.
///
/// The point of it is that reporting costs one sentence. Everything that would
/// otherwise have to be typed out -- which page, which account, which language,
/// what was running -- is captured here instead, on the server, where it cannot
/// be got wrong or forged.
model Report {
  id String @id @default(cuid())

  /// A short handle, because closing a report from the command line by cuid
  /// is not something anybody would do twice.
  number Int @unique @default(autoincrement())

  kind   ReportKind   @default(BUG)
  body   String
  status ReportStatus @default(OPEN)

  /// The page it was filed from.
  path   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Kept as written rather than read back off the user: a report that only
  /// happens to a WORKER, or only in Spanish, is a different report, and
  /// neither fact survives the account being changed.
  role   Role
  locale String

  /// Whatever was running when it was filed, when anything was.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  closedAt   DateTime?
  closedById String?
  /// Null for a close from the command line. The CLI is not a session, and
  /// putting a name against something that person did not do would be worse
  /// than leaving it blank.
  closedBy   User?     @relation("ReportCloser", fields: [closedById], references: [id])
  closedNote String?

  @@index([status, createdAt])
}

// -------------------------------------------------------------- meetings

enum MeetingStatus {
  DRAFT
  FINALISED
}

model Meeting {
  id        String        @id @default(cuid())
  title     String
  date      DateTime      @db.Date
  notes     String        @default("")
  status    MeetingStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  finalisedAt DateTime?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdById String
  createdBy   User   @relation("MeetingAuthor", fields: [createdById], references: [id])

  attendees   User[]       @relation("MeetingAttendees")
  actionItems ActionItem[]
  /// Work this meeting created.
  tasks       Task[]

  /// The task being worked on *as* this meeting, when it was started from
  /// My Day. Distinct from `tasks`, which is what the meeting produced.
  sourceTaskId String? @unique
  sourceTask   Task?   @relation("MeetingSourceTask", fields: [sourceTaskId], references: [id])

  @@index([date])
}

/// Decided in the meeting, not yet real work. Becomes a Task on finalisation
/// -- so an abandoned draft leaves no phantom tasks behind.
model ActionItem {
  id               String   @id @default(cuid())
  meetingId        String
  meeting          Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  /// No catalogue entry to inherit from, so this is always entered by hand.
  estimatedMinutes Int      @default(60)
  dueDate          DateTime @db.Date

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  /// When the meeting names a person, the engine skips ranking and gives it
  /// to them.
  pinnedAssigneeId String?
  pinnedAssignee   User?   @relation("ActionItemPin", fields: [pinnedAssigneeId], references: [id])

  taskId String? @unique
  task   Task?   @relation(fields: [taskId], references: [id])

  @@index([meetingId])
}

// ---------------------------------------------------------- sheet source

/// Column mapping lives in the database so the sheet layout can change
/// without a code change.
model SheetSource {
  id           String  @id @default(cuid())
  name         String
  spreadsheetId String
  tabName      String
  /// Column letters, e.g. { "title": "B", "dueDate": "D", "template": "C" }
  columnMap    Json
  /// Column whose value identifies a row across polls. Falls back to the row
  /// number when null.
  keyColumn    String?
  headerRows   Int     @default(1)
  active       Boolean @default(true)
  lastPolledAt DateTime?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
}

// ------------------------------------------------------------------- CRM

/// Relationship management, department by department. HR runs two: the
/// universities and job portals that supply interns, and the candidates coming
/// through selection.
///
/// The shape here is deliberately concrete rather than a configurable
/// entity/field builder. A second CRM later means new tables reusing the same
/// interaction log and the same call-due machinery, not a runtime schema.

enum CrmSourceType {
  UNIVERSITY
  JOB_PORTAL
}

/// A university or a job portal: somewhere interns come from.
model CrmSource {
  id   String        @id @default(cuid())
  name String
  type CrmSourceType @default(UNIVERSITY)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  /// The switchboard and the info@ address: how you reach the place itself
  /// when the person you know there has left, or before you know anybody.
  /// Distinct from CrmContact.phone/email, which belong to a named person.
  phone String?
  email String?

  /// When the intern offers on their board were last refreshed.
  offersUpdatedAt DateTime?
  /// Derived from the interaction log, stored so "who is due a call" is a
  /// query rather than an aggregate over every conversation ever had.
  lastContactedAt DateTime?
  notes           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  contacts     CrmContact[]
  candidates   Candidate[]
  interactions CrmInteraction[]

  @@unique([departmentId, name])
  @@index([departmentId, lastContactedAt])
}

/// A person inside one of those.
model CrmContact {
  id       String  @id @default(cuid())
  sourceId String
  source   CrmSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  name     String
  jobTitle String?
  phone    String?
  email    String?
  /// Anything worth remembering about this person before ringing them --
  /// "prefers email", "only Tuesdays", "left in September". Free text, and
  /// separate from the conversation log, which is what was actually said.
  notes    String?

  /// Drives the rotation: each cycle rings whoever was contacted longest ago,
  /// so a university hears from us through a different person each time.
  lastContactedAt DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())

  interactions CrmInteraction[]

  @@index([sourceId, lastContactedAt])
}

/// Where somebody is in selection. Only CALL raises work -- see crm/due.ts.
enum CandidateStage {
  APPLIED
  CALL
  PROCESS
  TEST
  OFFER
  HIRED
}

/// Why somebody dropped out. A fixed list so the reasons can be counted, with
/// a free note alongside for the detail that never fits a list.
enum CandidateDropReason {
  NOT_INTERESTED
  NO_REPLY
  REJECTED
  TOOK_ANOTHER_OFFER
  NOT_AVAILABLE
  OTHER
}

model Candidate {
  id    String @id @default(cuid())
  name  String
  phone String?
  email String?
  notes String?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  stage CandidateStage @default(APPLIED)

  /// Which university or portal they came from, when it is known.
  sourceId String?
  source   CrmSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  active     Boolean              @default(true)
  dropReason CandidateDropReason?
  dropNote   String?

  /// One attempt is the rule: reaching for them at all clears them from the
  /// call list, whether or not they picked up.
  lastAttemptedAt DateTime?
  createdAt       DateTime  @default(now())

  interactions CrmInteraction[]

  @@index([departmentId, stage, active])
  @@index([sourceId])
}

enum CrmOutcome {
  TALKED
  NO_ANSWER
  LEFT_MESSAGE
}

/// Every conversation, whoever it was with.
///
/// One table rather than one per entity, so "everything we have ever said to
/// this university, including to its people" is a single query. Exactly one of
/// sourceId / contactId / candidateId is set, enforced by a check constraint
/// that Prisma cannot express (see the migration).
model CrmInteraction {
  id String @id @default(cuid())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  sourceId String?
  source   CrmSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  contactId String?
  contact   CrmContact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  /// Who made the call.
  userId String
  user   User   @relation("CrmCaller", fields: [userId], references: [id])

  happenedAt DateTime   @default(now())
  outcome    CrmOutcome
  notes      String

  /// The batched call task it came from, when it came from one.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([sourceId, happenedAt])
  @@index([contactId, happenedAt])
  @@index([candidateId, happenedAt])
  @@index([departmentId, happenedAt])
}
