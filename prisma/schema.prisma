// MBE ERP data model.
//
// Three ideas drive the shape of this schema:
//
//   1. Availability is computed, never stored. A person's capacity on a date
//      comes from WorkingPattern -> DayOverride -> Absence, resolved by
//      getAvailability(). Nothing caches the result.
//   2. Fairness is remembered. RotationLedger is what stops the same person
//      always getting the same recurring job.
//   3. Nothing disappears silently. Tasks orphaned by an absence keep their
//      history, and every triage decision is recorded.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- people

/// Interface language. Data -- task names, notes, meeting minutes -- is left
/// exactly as typed, whichever this is set to.
enum Locale {
  EN
  ES
}

enum Role {
  WORKER
  MANAGER
  /// People operations: creates accounts and decides absence requests, across
  /// every department. Sits alongside MANAGER rather than above it -- HR does
  /// not run anyone else's schedule.
  HR
  ADMIN
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users          User[]
  taskTemplates  TaskTemplate[]
  recurringRules RecurringRule[]
  tasks          Task[]
  meetings       Meeting[]
  sheetSources   SheetSource[]
  actionItems    ActionItem[]
  p1ns           P1n[]
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(WORKER)
  locale       Locale   @default(ES)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  /// When they joined. Drives the onboarding interviews, and nothing is ever
  /// scheduled for them before it.
  startDate    DateTime? @db.Date
  /// When they leave. Null means indefinite -- most people. Nothing is
  /// scheduled past it, and the recurring review interviews stop there.
  endDate      DateTime? @db.Date

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  workingPatterns WorkingPattern[]
  dayOverrides    DayOverride[]
  absences        Absence[]        @relation("AbsenceSubject")
  absencesCreated Absence[]        @relation("AbsenceAuthor")
  absencesDecided Absence[]        @relation("AbsenceDecider")
  tasks           Task[]           @relation("TaskAssignee")
  timeEntries     TimeEntry[]
  rotation        RotationLedger[]
  sessions        Session[]
  triageActions   TriageAction[]
  deferrals       TaskDeferral[]
  p1ns            P1n[]
  p1nsApplied     P1n[]            @relation("P1nApplier")
  meetingsCreated Meeting[]        @relation("MeetingAuthor")
  meetingsAttended Meeting[]       @relation("MeetingAttendees")
  pinnedItems     ActionItem[]     @relation("ActionItemPin")

  @@index([departmentId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ------------------------------------------------------------ time model

/// One row per weekday per person. Different hours on different days is just
/// different rows -- Monday 09:00-18:00 and Friday 09:00-14:00 coexist here.
/// Times are minutes from midnight in SCHEDULE_TIMEZONE, which keeps the
/// arithmetic free of DST edge cases.
model WorkingPattern {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 1 = Monday ... 7 = Sunday (ISO weekday)
  weekday      Int
  startMinutes Int
  endMinutes   Int
  breakMinutes Int    @default(0)
  /// When the break sits at a known time, tasks are scheduled around it and
  /// the day splits in two. When null, the break still costs capacity but
  /// work can be placed anywhere.
  breakStartMinutes Int?

  @@unique([userId, weekday])
}

/// A specific date where this person's hours differ from their weekday
/// pattern. Beats the pattern entirely for that date.
model DayOverride {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  startMinutes Int
  endMinutes   Int
  breakMinutes Int      @default(0)
  breakStartMinutes Int?
  note         String?

  @@unique([userId, date])
}

enum AbsenceScope {
  FULL_DAY
  PARTIAL
}

/// Coarse category only. Deliberately not a free-text medical field --
/// see the GDPR note in the README.
enum AbsenceCategory {
  SICK
  HOLIDAY
  PERSONAL
  OTHER
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

model Absence {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation("AbsenceSubject", fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime        @db.Date
  endDate   DateTime        @db.Date
  scope     AbsenceScope    @default(FULL_DAY)
  /// Only meaningful when scope = PARTIAL. Minutes from midnight.
  startMinutes Int?
  endMinutes   Int?
  category  AbsenceCategory
  note      String?
  createdAt DateTime        @default(now())

  /// HR decides every absence, but sickness does not wait for the decision --
  /// see isEffective() in src/lib/absence/effective.ts. A pending sick day
  /// already affects the schedule; a pending holiday does not.
  status       AbsenceStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?         @relation("AbsenceDecider", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?

  createdById String
  createdBy   User   @relation("AbsenceAuthor", fields: [createdById], references: [id])

  @@index([userId, startDate, endDate])
  @@index([status])
}

// ------------------------------------------------------------------ work

/// The task catalogue. Durations already exist here, so instances inherit
/// rather than guess.
model TaskTemplate {
  id               String   @id @default(cuid())
  name             String
  category         String?
  estimatedMinutes Int
  /// Warnings and gotchas from the catalogue -- "max 1 integrante por dia",
  /// "apuntalo en el calendario para que no se solape". Shown on the task,
  /// because a rule nobody sees at the moment of doing the work is not a rule.
  notes            String?
  /// Where to look for how to do it: "Ver Calendar", "Ver ModeloPreguntas".
  instructions     String?
  /// True for tasks that are actually meetings -- starting one opens the
  /// notes pane instead of just running a timer.
  isMeeting        Boolean  @default(false)
  /// True when the estimate is for one go and people normally do several --
  /// a candidate call, an invoice, a check-in. Lets the day hold "10 calls"
  /// as one block instead of ten identical rows.
  repeatable       Boolean  @default(false)
  priority         Priority @default(NORMAL)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  recurringRules RecurringRule[]
  tasks          Task[]
  rotation       RotationLedger[]

  @@unique([departmentId, name])
}

/// How hard a task pushes for capacity.
enum Priority {
  /// Has to happen. Takes first claim on the day and is assigned even when
  /// everybody is full, so the overload is visible rather than the task
  /// quietly vanishing.
  MUST
  /// Normal work: scheduled when there is room.
  NORMAL
  /// Backlog. Only appears once everything else has been placed and somebody
  /// still has hours free.
  SPARE_TIME
}

enum Frequency {
  WEEKLY
  MONTHLY
}

/// "This catalogue task happens every Monday and Thursday", or "the last
/// Monday of the month". Modelled on the subset of iCalendar recurrence the
/// company's calendar actually uses -- weekly by weekday, and monthly by
/// nth-weekday or day-of-month.
model RecurringRule {
  id                    String  @id @default(cuid())
  templateId            String
  template              TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  departmentId          String
  department            Department   @relation(fields: [departmentId], references: [id])

  frequency             Frequency @default(WEEKLY)
  /// ISO weekdays this fires on, e.g. [1, 4] for Monday and Thursday. For a
  /// MONTHLY rule this holds the single weekday that monthlyNth counts.
  weekdays              Int[]
  /// MONTHLY only: which occurrence of that weekday. 1 = first, -1 = last
  /// (RRULE BYDAY=-1MO). Null when the rule uses monthlyDay instead.
  monthlyNth            Int?
  /// MONTHLY only: a fixed day of the month (RRULE BYMONTHDAY=22).
  monthlyDay            Int?

  instancesPerOccurrence Int    @default(1)
  /// Optional fixed slot. When set, the task must land in this window and is
  /// placed before flexible work. Only genuine appointments get one -- most
  /// calendar times are reminders, and pinning them all makes the schedule
  /// unsolvable.
  fixedStartMinutes     Int?
  fixedEndMinutes       Int?
  active                Boolean @default(true)
  /// Where this came from, for tracing an odd schedule back to its source.
  sourceNote            String?

  @@index([departmentId])
}

enum TaskOrigin {
  RECURRING
  CATALOGUE
  SHEET
  MEETING
  MANUAL
}

enum TaskStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  PAUSED
  ORPHANED
  DONE
  CANCELLED
}

model Task {
  id               String     @id @default(cuid())
  title            String
  description      String?
  /// Always the total: unitMinutes x quantity. Everything that reasons about
  /// capacity reads this and needs to know nothing about repeats.
  estimatedMinutes Int
  /// Minutes for one go, when this is a repeatable task.
  unitMinutes      Int?
  /// How many are planned.
  quantity         Int        @default(1)
  /// How many have actually been done, counted while working.
  doneCount        Int        @default(0)
  dueDate          DateTime   @db.Date
  origin           TaskOrigin
  status           TaskStatus @default(UNASSIGNED)
  /// Copied from the template when the task is created, so changing the
  /// catalogue later does not rewrite work already scheduled.
  priority         Priority   @default(NORMAL)
  createdAt        DateTime   @default(now())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  templateId String?
  template   TaskTemplate? @relation(fields: [templateId], references: [id])

  meetingId String?
  meeting   Meeting? @relation(fields: [meetingId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  /// Stable identity for generated work, so re-running the materializer or
  /// re-polling the sheet updates instead of duplicating.
  externalKey String? @unique

  scheduledDate  DateTime? @db.Date
  scheduledStart Int?
  scheduledEnd   Int?

  orphanedAt   DateTime?
  orphanReason String?

  timeEntries   TimeEntry[]
  triageActions TriageAction[]
  deferrals     TaskDeferral[]
  p1ns          P1n[]
  actionItem    ActionItem?
  /// Set when this task is itself a meeting being minuted.
  hostedMeeting Meeting?       @relation("MeetingSourceTask")

  @@index([departmentId, dueDate])
  @@index([assigneeId, scheduledDate])
  @@index([status])
}

model TimeEntry {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  pauses PauseEvent[]

  @@index([taskId])
  @@index([userId, startedAt])
}

enum PauseReason {
  BREAK
  WAITING_CLIENT
  WAITING_INTERNAL
  MEETING
  INTERRUPTION
  OTHER
}

/// Every pause carries a written reason. That requirement is the whole point:
/// the system surfaces why work stalled instead of who was idle.
model PauseEvent {
  id          String      @id @default(cuid())
  timeEntryId String
  timeEntry   TimeEntry   @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  pausedAt    DateTime    @default(now())
  resumedAt   DateTime?
  reasonCode  PauseReason
  reasonText  String

  @@index([timeEntryId])
}

/// Fairness memory: how often this person has done this template, and when
/// they last got it. Drives rotation ranking.
model RotationLedger {
  id             String    @id @default(cuid())
  templateId     String
  template       TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Times this person has been *given* the job. This is what rotation ranks
  /// on -- fairness is about who gets handed the work, and a task assigned
  /// but not yet finished still counts as their turn.
  assignedCount  Int       @default(0)
  /// Times they actually finished it. Kept for reporting (and for spotting a
  /// job that keeps getting handed over half-done), not for ranking.
  completedCount Int       @default(0)
  lastAssignedAt DateTime?

  @@unique([templateId, userId])
}

enum TriageResolution {
  REASSIGNED
  PUSHED
  CANCELLED
}

/// Why somebody could not do a task when they were meant to, and when they
/// said they would instead. Written when the day's order is overridden.
model TaskDeferral {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  reason    String
  fromDate  DateTime @db.Date
  toDate    DateTime @db.Date
  createdAt DateTime @default(now())

  @@index([taskId])
  @@index([userId, createdAt])
}

/// Why a task moved. Written whenever a manager resolves an orphan.
model TriageAction {
  id         String           @id @default(cuid())
  taskId     String
  task       Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  resolvedById String
  resolvedBy   User           @relation(fields: [resolvedById], references: [id])
  resolution TriageResolution
  detail     String?
  createdAt  DateTime         @default(now())

  @@index([taskId])
}

// ------------------------------------------------------------------ P1N

/// Why the mistake happened. In practice it is nearly always one of the first
/// two, and telling them apart is the whole point: one is fixed by paying
/// attention, the other by fixing the process.
enum P1nCause {
  /// Dejadez -- not attentive enough.
  ATTENTION
  /// It was not written down or explained properly.
  PROCESS
  OTHER
}

/// "Pasa 1 vez, no vuelve a pasar."
///
/// Somebody reports their own mistake, says why it happened and proposes what
/// would stop it happening again -- to them or to whoever comes after. The
/// department can read them, because a fix nobody sees teaches nobody.
model P1n {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  mistake   String
  cause     P1nCause
  solution  String

  /// The task it happened on, when there was one.
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  /// Set when the proposed fix has actually been made, which is the only
  /// thing that turns a report into a change.
  appliedAt   DateTime?
  appliedById String?
  appliedBy   User?     @relation("P1nApplier", fields: [appliedById], references: [id])
  appliedNote String?

  @@index([departmentId, createdAt])
  @@index([userId])
}

// -------------------------------------------------------------- meetings

enum MeetingStatus {
  DRAFT
  FINALISED
}

model Meeting {
  id        String        @id @default(cuid())
  title     String
  date      DateTime      @db.Date
  notes     String        @default("")
  status    MeetingStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  finalisedAt DateTime?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  createdById String
  createdBy   User   @relation("MeetingAuthor", fields: [createdById], references: [id])

  attendees   User[]       @relation("MeetingAttendees")
  actionItems ActionItem[]
  /// Work this meeting created.
  tasks       Task[]

  /// The task being worked on *as* this meeting, when it was started from
  /// My Day. Distinct from `tasks`, which is what the meeting produced.
  sourceTaskId String? @unique
  sourceTask   Task?   @relation("MeetingSourceTask", fields: [sourceTaskId], references: [id])

  @@index([date])
}

/// Decided in the meeting, not yet real work. Becomes a Task on finalisation
/// -- so an abandoned draft leaves no phantom tasks behind.
model ActionItem {
  id               String   @id @default(cuid())
  meetingId        String
  meeting          Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  /// No catalogue entry to inherit from, so this is always entered by hand.
  estimatedMinutes Int      @default(60)
  dueDate          DateTime @db.Date

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  /// When the meeting names a person, the engine skips ranking and gives it
  /// to them.
  pinnedAssigneeId String?
  pinnedAssignee   User?   @relation("ActionItemPin", fields: [pinnedAssigneeId], references: [id])

  taskId String? @unique
  task   Task?   @relation(fields: [taskId], references: [id])

  @@index([meetingId])
}

// ---------------------------------------------------------- sheet source

/// Column mapping lives in the database so the sheet layout can change
/// without a code change.
model SheetSource {
  id           String  @id @default(cuid())
  name         String
  spreadsheetId String
  tabName      String
  /// Column letters, e.g. { "title": "B", "dueDate": "D", "template": "C" }
  columnMap    Json
  /// Column whose value identifies a row across polls. Falls back to the row
  /// number when null.
  keyColumn    String?
  headerRows   Int     @default(1)
  active       Boolean @default(true)
  lastPolledAt DateTime?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
}
