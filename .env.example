# Local development database.
# Created and started by `npm run db:start` (see scripts/pg.sh).
DATABASE_URL="postgresql://postgres@localhost:5433/task_erp"

# UNUSED. No code reads this. Session cookies carry a random token and the
# database stores only its SHA-256, so there is nothing to sign. Kept here only
# because older deployment notes tell you to set it; setting it does nothing.
SESSION_SECRET=""

# Optional: a known password for the founding accounts created by `npm run seed`.
# Leave unset and the seed generates a random one and prints it once.
SEED_PASSWORD=""

# Timezone the schedule is computed in. All working hours, absences and
# task slots are interpreted in this zone.
SCHEDULE_TIMEZONE="Europe/Madrid"

# Google Sheets ingest (step 11). Leave blank until that source is wired up.
# Path to a service-account JSON key with read access to the sheet.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=""
